"""
src/graphics_engine.py

Procedural graphics and world‑engine utilities for generating visual parameters
such as dungeon colour palettes, neon lighting moods, wall aesthetics and room
styles.  The functions are deliberately deterministic to keep unit‑tests stable.
"""

from __future__ import annotations

__all__ = [
    "generate_dungeon_palette",
    "generate_neon_mood",
    "get_wall_aesthetic",
    "get_room_style",
]


def generate_dungeon_palette() -> list[str]:
    """
    Return a deterministic colour palette suitable for a dungeon environment.

    The palette consists of four hexadecimal colour strings ranging from dark
    to medium tones.
    """
    return ["#2b2b2b", "#4e4e4e", "#6b6b6b", "#8a8a8a"]


def generate_neon_mood() -> dict[str, str | float]:
    """
    Return a deterministic neon lighting mood.

    The dictionary contains:
        - ``primary``:   primary neon colour (hex string)
        - ``secondary``: secondary neon colour (hex string)
        - ``intensity``: floating‑point intensity factor between 0 and 1
    """
    return {
        "primary": "#ff00ff",
        "secondary": "#00ffff",
        "intensity": 0.8,
    }


def get_wall_aesthetic() -> str:
    """
    Return a deterministic description of a wall aesthetic.
    """
    return "cracked stone"


def get_room_style() -> str:
    """
    Return a deterministic description of a room style.
    """
    return "gothic"