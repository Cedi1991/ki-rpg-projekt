                raise ValueError(f"Ingredient-Menge für '{item_id}' muss eine positive Ganzzahl sein.")
        if self.required_level < 1:
            raise ValueError("Recipe.required_level muss >= 1 sein.")
        if self.crafting_time < 0:
            raise ValueError("Recipe.crafting_time muss >= 0 sein.")

