"""Crafting & Werkstätten - Rezept-System für Spieler."""

from dataclasses import dataclass, field
from typing import Dict, List, Optional, Any


@dataclass
class Item:
    """Repräsentiert ein Spiel-Item."""
    id: str
    name: str
    description: str = ""
    stack_size: int = 1
    metadata: Dict[str, Any] = field(default_factory=dict)

    def __post_init__(self):
        if not self.id or not isinstance(self.id, str):
            raise ValueError("Item.id muss ein nicht-leerer String sein.")
        if not self.name or not isinstance(self.name, str):
            raise ValueError("Item.name muss ein nicht-leerer String sein.")
        if self.stack_size < 1:
            raise ValueError("Item.stack_size muss >= 1 sein.")


@dataclass
