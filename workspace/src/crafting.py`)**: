    crafting_time: float = 1.0  # in Sekunden
    metadata: Dict[str, Any] = field(default_factory=dict)

    def __post_init__(self):
        if not self.id or not isinstance(self.id, str):
            raise ValueError("Recipe.id muss ein nicht-leerer String sein.")
        if not self.name or not isinstance(self.name, str):
            raise ValueError("Recipe.name muss ein nicht-leerer String sein.")
        if not isinstance(self.result, Item):
            raise ValueError("Recipe.result muss ein Item-Objekt sein.")
        if not isinstance(self.ingredients, dict):
            raise ValueError("Recipe.ingredients muss ein Dict sein.")
        for item_id, amount in self.ingredients.items():
            if not isinstance(item_id, str) or not item_id:
