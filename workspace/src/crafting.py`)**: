class QualityTier(Enum):
    """Qualitätsstufen für hergestellte Gegenstände."""
    COMMON = auto()
    UNCOMMON = auto()
    RARE = auto()
    EPIC = auto()
    LEGENDARY = auto()

    @staticmethod
    def from_score(score: float) -> "QualityTier":
        """Bestimmt die Qualitätsstufe anhand eines Scores von 0‑5."""
        if score >= 4.5:
            return QualityTier.LEGENDARY
        if score >= 3.5:
            return QualityTier.EPIC
        if score >= 2.5:
            return QualityTier.RARE
        if score >= 1.5:
            return QualityTier.UNCOMMON
        return QualityTier.COMMON

    def multiplier(self) -> float:
        """Multiplikator, der auf Basiswerte angewendet wird."""
        return {
            QualityTier.COMMON: 1.0,
            QualityTier.UNCOMMON: 1.1,
            QualityTier.RARE: 1.25,
            QualityTier.EPIC: 1.5,
            QualityTier.LEGENDARY: 2.0,
        }[self]


