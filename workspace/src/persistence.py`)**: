import json


def save_player_to_json(player):
    """
    Serialisiert den Spielstand (player) in eine JSON-String.
    
    Args:
        player: Ein dict oder ein Objekt mit einem `to_dict()`-Methode,
                das den Spielstand repräsentiert.
    
    Returns:
        str: Der JSON-serialisierte String.
    """
    if hasattr(player, 'to_dict'):
        data = player.to_dict()
    elif isinstance(player, dict):
        data = player
    else:
        raise TypeError("player muss ein dict oder ein Objekt mit to_dict() sein")
    
    return json.dumps(data, ensure_ascii=False, indent=2)


def load_player_from_json(json_str):
    """
    Deserialisiert einen JSON-String zurück in einen Spielstand.
    
    Args:
        json_str: Ein JSON-String, der den Spielstand enthält.
    
    Returns:
        dict: Der deserialisierte Spielstand als dict.
    """
    if not isinstance(json_str, str):
        raise TypeError("json_str muss ein String sein")
    
    try:
        data = json.loads(json_str)
    except json.JSONDecodeError as e:
        raise ValueError(f"Ungültiger JSON-String: {e}")
    
    if not isinstance(data, dict):
        raise ValueError("Der JSON-String muss ein Objekt (dict) enthalten")
    
    return data