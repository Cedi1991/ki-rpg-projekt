# src/npc_ai.py

from __future__ import annotations
from dataclasses import dataclass, field
from typing import Dict, List, Optional


@dataclass
class NPCMemory:
    """Speichert Erinnerungen eines NPCs zu einem bestimmten Spieler."""
    steals: int = 0
    interactions: int = 0
    quests: List[str] = field(default_factory=list)


class NPC:
    """
    Verhaltensbasiertes NPC-System mit Gedächtnis.

    Jeder NPC hat einen Basispreis für Waren. Der Preis wird pro Diebstahl
    des Spielers um 10 % erhöht. Außerdem kann der NPC Quests vergeben,
    die von der Historie der Interaktionen abhängen.
    """

    def __init__(self, name: str, base_price: float):
        self.name: str = name
        self.base_price: float = base_price
        # Speicher: player_id -> NPCMemory
        self._memories: Dict[str, NPCMemory] = {}

    # ------------------------------------------------------------------
    # Interaktionslogik
    # ------------------------------------------------------------------
    def interact(self, player_id: str, action: str) -> None:
        """
        Interaktion mit einem Spieler.

        :param player_id: eindeutige Kennung des Spielers
        :param action: 'trade', 'steal', 'talk', ...
        """
        memory = self._memories.setdefault(player_id, NPCMemory())
        memory.interactions += 1

        if action == "steal":
            memory.steals += 1

    # ------------------------------------------------------------------
    # Preisberechnung
    # ------------------------------------------------------------------
    def get_price(self, player_id: str) -> float:
        """
        Liefert den aktuellen Preis für den Spieler unter Berücksichtigung
        von Diebstählen. Der Preis wird pro Diebstahl um 10 % erhöht.

        :param player_id: eindeutige Kennung des Spielers
        :return: Preis als float, gerundet auf zwei Nachkommastellen
        """
        memory = self._memories.get(player_id, NPCMemory())
        multiplier = 1 + 0.1 * memory.steals
        price = self.base_price * multiplier
        return round(price, 2)

