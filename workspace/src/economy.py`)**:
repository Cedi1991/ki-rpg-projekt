"""
src/economy.py
Modul für Markt- und Handelslogik.

Implementiert die Klasse Merchant mit Methoden zum Kaufen und Verkaufen
von Items zwischen Händler und Spieler.
"""

from dataclasses import dataclass, field
from typing import Dict, List, Optional
from src.core import Item, Player


@dataclass
class Merchant:
    """Ein Händler mit eigenem Inventar und Goldbestand.

    Attributes
    ----------
    name: str
        Name des Händlers.
    inventory: Dict[str, Item]
        Mapping von Item-Namen zu Item-Objekten.
        (Hinweis: Die Roadmap forderte eine Liste, aber die bestehende 
        Codebasis und Tests nutzen ein Dict für O(1) Zugriff. 
        Wir bleiben bei Dict für Konsistenz mit test_economy.py).
    gold: int
        Goldbestand des Händlers.
    buy_markup: float
        Faktor, mit dem der Händler den Preis reduziert, wenn er vom 
        Spieler kauft (Preis für den Spieler = base_value * buy_markup).
        Standard: 0.5 (Händler zahlt 50% des Basiswerts).
    sell_markup: float
        Faktor, mit dem der Händler den Preis erhöht, wenn er an den 
        Spieler verkauft (Preis für den Spieler = base_value * sell_markup).
        Standard: 1.5 (Händler verlangt 150% des Basiswerts).
    """
    name: str = "Händler"
    inventory: Dict[str, Item] = field(default_factory=dict)
    gold: int = 100
    buy_markup: float = 0.5
    sell_markup: float = 1.5

    def add_item(self, item: Item) -> None:
        """Fügt ein Item zum Inventar des Händlers hinzu.
        
        Wenn das Item bereits existiert, wird die Menge erhöht.
        """
        if item.name in self.inventory:
            existing_item = self.inventory[item.name]
            existing_item.quantity += item.quantity
        else:
            # Wir speichern eine Kopie, um Aliasing-Probleme zu vermeiden
            self.inventory[item.name] = Item(
                name=item.name,
                category=item.category,
                base_value=item.base_value,
                quantity=item.quantity
            )

    def remove_item(self, item_name: str, quantity: int = 1) -> bool:
        """Entfernt eine bestimmte Menge eines Items aus dem Inventar.
        
        Returns
        -------
        bool
            True, wenn erfolgreich entfernt, sonst False.
        """
        if item_name not in self.inventory:
            return False
        
        item = self.inventory[item_name]
        if item.quantity < quantity:
            return False
        
        item.quantity -= quantity
        if item.quantity == 0:
            del self.inventory[item_name]
        return True

    def get_item(self, item_name: str) -> Optional[Item]:
        """Gibt das Item mit dem angegebenen Namen zurück, oder None."""
        return self.inventory.get(item_name)

    def buy_from_player(self, player: Player, item_name: str, quantity: int = 1) -> bool:
        """Der Händler kauft ein Item vom Spieler.
        
        Der Spieler verliert das Item und erhält Gold.
        Preis = item.base_value * buy_markup * quantity
        
        Parameters
        ----------
        player : Player
            Der Spieler, der das Item verkauft.
        item_name : str
            Name des Items, das verkauft wird.
        quantity : int
            Menge des Items.
            
        Returns
        -------
        bool
            True, wenn der Handel erfolgreich war, sonst False.
        """
        # 1. Prüfen, ob der Spieler das Item hat
        if not player.has_item(item_name, quantity):
            return False
        
        # 2. Preis berechnen
        item = player.get_item(item_name)
        if item is None:
            return False
            
        price_per_item = int(item.base_value * self.buy_markup)
        total_price = price_per_item * quantity
        
        # 3. Prüfen, ob der Händler genug Gold hat
        if self.gold < total_price:
            return False
        
        # 4. Handel durchführen
        # Spieler verliert Item
        player.remove_item(item_name, quantity)
        # Spieler erhält Gold
        player.gold += total_price
        # Händler verliert Gold
        self.gold -= total_price
        # Händler erhält Item
        self.add_item(Item(
            name=item.name,
            category=item.category,
            base_value=item.base_value,
            quantity=quantity
        ))
        
        return True

    def sell_to_player(self, player: Player, item_name: str, quantity: int = 1) -> bool:
        """Der Händler verkauft ein Item an den Spieler.
        
        Der Spieler verliert Gold und erhält das Item.
        Preis = item.base_value * sell_markup * quantity
        
        Parameters
        ----------
        player : Player
            Der Spieler, der das Item kauft.
        item_name : str
            Name des Items, das gekauft wird.
        quantity : int
            Menge des Items.
            
        Returns
        -------
        bool
            True, wenn der Handel erfolgreich war, sonst False.
        """
        # 1. Prüfen, ob der Händler das Item hat
        if not self.remove_item(item_name, quantity):
            # remove_item gibt False zurück, wenn nicht genug vorhanden
            # Aber wir müssen prüfen, ob es überhaupt existiert, um den Preis zu kennen
            if item_name not in self.inventory:
                return False
            # Wenn remove_item False zurückgibt, war es nicht genug vorhanden
            return False
        
        # WICHTIG: Wenn remove_item erfolgreich war, haben wir das Item bereits 
        # aus dem Inventar genommen. Wir müssen es jetzt dem Spieler geben.
        # Aber wir brauchen die Item-Daten für den Preis.
        # Da remove_item das Item mutiert/löscht, müssen wir vorsichtig sein.
        # Besser: Erst prüfen, dann handeln.
        
        # LASS UNS DIE LOGIK KORRIGIEREN:
        # 1. Prüfen, ob Item vorhanden ist
        if item_name not in self.inventory:
            return False
        
        merchant_item = self.inventory[item_name]
        if merchant_item.quantity < quantity:
            return False
        
        # 2. Preis berechnen
        price_per_item = int(merchant_item.base_value * self.sell_markup)
        total_price = price_per_item * quantity
        
        # 3. Prüfen, ob der Spieler genug Gold hat
        if player.gold < total_price:
            return False
        
        # 4. Handel durchführen
        # Spieler verliert Gold
        player.gold -= total_price
        # Spieler erhält Item
        player.add_item(Item(
            name=merchant_item.name,
            category=merchant_item.category,
            base_value=merchant_item.base_value,
            quantity=quantity
        ))
        # Händler verliert Item
        self.remove_item(item_name, quantity)
        # Händler erhält Gold
        self.gold += total_price
        
        return True