"""src/dialogue.py
Ein einfaches, rein datengetriebenes Dialogsystem.

Das System besteht aus drei Kern‑Klassen:

* ``DialogueOption`` – Eine Auswahl, die dem Spieler angezeigt wird.
* ``DialogueNode``   – Ein Knoten im Dialogbaum, enthält Text und Optionen.
* ``DialogueManager`` – Steuert den Fortschritt durch den Baum.

Alle Klassen sind deterministisch und leicht testbar – es gibt keinerlei
Zufallslogik oder Seiteneffekte.  Der Manager kann sowohl per Index als
auch per Text einer Option angesprochen werden, was die Unit‑Tests
flexibel gestaltet.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import List, Dict, Optional


# --------------------------------------------------------------------------- #
#   Datenklassen
# --------------------------------------------------------------------------- #
@dataclass(frozen=True)
class DialogueOption:
    """Eine auswählbare Option innerhalb eines Dialogknotens.

    Attributes
    ----------
    text: str
        Der Text, der dem Spieler präsentiert wird.
    next_node: Optional[str]
        Die ID des nächsten Knotens.  ``None`` bedeutet, dass der Dialog
        hier endet.
    """
    text: str
    next_node: Optional[str] = None


@dataclass
class DialogueNode:
    """Ein Knoten im Dialogbaum.

    Attributes
    ----------
    node_id: str
        Eindeutige Kennung des Knotens.
    text: str
        Der Dialogtext, der dem Spieler angezeigt wird.
    options: List[DialogueOption]
        Liste aller zur Verfügung stehenden Optionen.
    """
    node_id: str
    text: str
    options: List[DialogueOption] = field(default_factory=list)


# --------------------------------------------------------------------------- #
#   Manager
# --------------------------------------------------------------------------- #
class DialogueManager:
    """Steuert den Durchlauf eines Dialogbaums.

    Der Manager wird mit einer Liste von :class:`DialogueNode`‑Objekten
    initialisiert.  Der erste aktive Knoten ist standardmäßig der Knoten
    mit der ID ``"start"`` – falls ein anderer Startknoten gewünscht ist,
    kann er über ``start_node_id`` angegeben werden.

    Beispiele
    --------
    >>> manager = DialogueManager(nodes)
    >>> manager.current_node.node_id
    'start'
    >>> manager.choose_option(0)          # wählt die erste Option
    >>> manager.current_node.node_id
    'greet'
    >>> manager.is_finished
    False
    >>> manager.choose_option_by_text('Tschüss')
    >>> manager.is_finished
    True
    """

    def __init__(self, nodes: List[DialogueNode], start_node_id: str = "start"):
        # Mapping von node_id → DialogueNode für schnellen Zugriff
        self._nodes: Dict[str, DialogueNode] = {n.node_id: n for n in nodes}
        if start_node_id not in self._nodes:
            raise ValueError(f"Start‑Knoten '{start_node_id}' ist nicht im Dialogbaum enthalten.")
        self._current_node_id: Optional[str] = start_node_id
        self._finished: bool = False

    # --------------------------------------------------------------------- #
    #   Eigenschaften
    # --------------------------------------------------------------------- #
    @property
    def current_node(self) -> Optional[DialogueNode]:
        """Der aktuell aktive Dialogknoten oder ``None``, falls der Dialog beendet ist."""
        if self._finished or self._current_node_id is None:
            return None
        return self._nodes[self._current_node_id]

    @property
    def is_finished(self) -> bool:
        """True, wenn der Dialog bereits abgeschlossen wurde."""
        return self._finished

    # --------------------------------------------------------------------- #
    #   Interaktion
    # --------------------------------------------------------------------- #
    def _advance_to(self, next_node_id: Optional[str]) -> None:
        """Interner Helfer, um den internen Zustand zu aktualisieren."""
        if next_node_id is None:
            # ``None`` signalisiert das Ende des Dialogs
            self._finished = True
            self._current_node_id = None
        else:
            if next_node_id not in self._nodes:
                raise ValueError(f"Unbekannte Ziel‑Knoten‑ID '{next_node_id}'.")
            self._current_node_id = next_node_id

    def choose_option(self, index: int) -> None:
        """Wählt die Option mit dem angegebenen Listen‑Index aus.

        Parameters
        ----------
        index: int
            Der Index in ``current_node.options`` (0‑basiert).

        Raises
        ------
        IndexError
            Wenn der Index außerhalb des gültigen Bereichs liegt.
        RuntimeError
            Wenn versucht wird, eine Option zu wählen, obwohl der Dialog bereits beendet ist.
        """
        if self.is_finished:
            raise RuntimeError("Der Dialog ist bereits beendet.")
        options = self.current_node.options
        if not (0 <= index < len(options)):
            raise IndexError(f"Option‑Index {index} ist ungültig (es gibt {len(options)} Optionen).")
        chosen = options[index]
        self._advance_to(chosen.next_node)

    def choose_option_by_text(self, text: str) -> None:
        """Wählt die erste Option, deren ``text`` exakt mit *text* übereinstimmt.

        Dies ist praktisch für lesbare Tests, bei denen der Index nicht
        bekannt ist.

        Raises
        ------
        ValueError
            Wenn keine passende Option gefunden wird.
        """
        if self.is_finished:
            raise RuntimeError("Der Dialog ist bereits beendet.")
        for idx, opt in enumerate(self.current_node.options):
            if opt.text == text:
                self.choose_option(idx)
                return
        raise ValueError(f"Keine Option mit Text '{text}' im aktuellen Knoten gefunden.")

    def get_options(self) -> List[DialogueOption]:
        """Gibt die Optionen des aktuellen Knotens zurück (leere Liste, falls beendet)."""
        return [] if self.is_finished else list(self.current_node.options)

    # --------------------------------------------------------------------- #
    #   Debug‑Hilfen
    # --------------------------------------------------------------------- #
    def __repr__(self) -> str:
        if self.is_finished:
            return "<DialogueManager finished>"
        return f"<DialogueManager at node '{self._current_node_id}'>"