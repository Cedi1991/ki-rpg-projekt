import random
from enum import Enum, auto
from typing import Optional


class WeatherType(Enum):
    CLEAR = auto()
    RAIN = auto()
    FOG = auto()
    STORM = auto()
    THUNDERSTORM = auto()


# Mapping of weather type to its effects
_VISIBILITY = {
    WeatherType.CLEAR: 1000,          # essentially unlimited
    WeatherType.RAIN: 30,
    WeatherType.FOG: 15,
    WeatherType.STORM: 10,
    WeatherType.THUNDERSTORM: 8,
}

_MOVEMENT_MODIFIER = {
    WeatherType.CLEAR: 1.0,
    WeatherType.RAIN: 0.9,
    WeatherType.FOG: 0.85,
    WeatherType.STORM: 0.7,
    WeatherType.THUNDERSTORM: 0.6,
}

_BOSS_AGGRESSION_MODIFIER = {
    WeatherType.CLEAR: 1.0,
    WeatherType.RAIN: 1.0,
    WeatherType.FOG: 1.1,
    WeatherType.STORM: 1.3,
    WeatherType.THUNDERSTORM: 1.5,
}


class Weather:
    """
    Simple dynamic weather system for a dungeon crawler.
    """

    def __init__(self) -> None:
        self._type: WeatherType = WeatherType.CLEAR
        self._remaining: float = 0.0  # seconds; 0 means no active weather

    @property
    def type(self) -> WeatherType:
        """Current weather type."""
        return self._type

    @property
    def remaining(self) -> float:
        """Time left for the current weather in seconds."""
        return self._remaining

    @property
    def visibility(self) -> int:
        """Maximum visibility distance for the current weather."""
        return _VISIBILITY[self._type]

    @property
    def movement_modifier(self) -> float:
        """Multiplier applied to player movement speed."""
        return _MOVEMENT_MODIFIER[self._type]

    @property
    def boss_aggression_modifier(self) -> float:
        """Multiplier applied to boss AI aggression."""
        return _BOSS_AGGRESSION_MODIFIER[self._type]

    def set_weather(self, weather_type: WeatherType, duration: float) -> None:
        """
        Activate a specific weather for a given duration (seconds).
        Passing duration <= 0 clears the weather (reverts to CLEAR).
        """
        if duration <= 0 or weather_type == WeatherType.CLEAR:
            self._type = WeatherType.CLEAR
            self._remaining = 0.0
        else:
            self._type = weather_type
            self._remaining = max(duration, 0.0)

    def clear(self) -> None:
        """Immediately revert to clear weather."""
        self.set_weather(WeatherType.CLEAR, 0)

    def update(self, delta_seconds: float) -> None:
        """
        Progress the weather timer. If the timer expires, revert to clear weather.
        """
        if self._type == WeatherType.CLEAR:
            return
        self._remaining -= delta_seconds
        if self._remaining <= 0:
            self.clear()

    def apply_to_player(self, player) -> None:
        """
        Adjust the player's movement speed according to the current weather.
        The player object must have attributes `base_speed` and `speed`.
        """
        if not hasattr(player, "base_speed"):
            raise AttributeError("Player object must have a 'base_speed' attribute")
        player.speed = player.base_speed * self.movement_modifier

    def apply_to_boss(self, boss) -> None:
        """
        Adjust the boss's aggression level according to the current weather.
        The boss object must have attributes `base_aggression` and `aggression`.
        """
        if not hasattr(boss, "base_aggression"):
            raise AttributeError("Boss object must have a 'base_aggression' attribute")
        boss.aggression = boss.base_aggression * self.boss_aggression_modifier

    # --------------------------------------------------------------------- #
    # Helper utilities
    # --------------------------------------------------------------------- #

    @staticmethod
    def random