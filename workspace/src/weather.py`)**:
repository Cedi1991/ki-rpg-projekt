]


@dataclass(frozen=True)
class Weather:
    """Enumeration of supported weather types."""
    name: str

    # Predefined weather instances
    CLEAR: "Weather" = None  # type: ignore
    STORM: "Weather" = None  # type: ignore
    FOG: "Weather" = None  # type: ignore

    def __post_init__(self):
        # Ensure the name is one of the allowed values
        allowed = {"clear", "storm", "fog"}
        if self.name not in allowed:
            raise ValueError(f"Unsupported weather: {self.name!r}")

    def __str__(self) -> str:
        return self.name

    def __repr__(self) -> str:
        return f"Weather(name={self.name!r})"


# Initialize the class-level constants
