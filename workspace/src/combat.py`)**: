"""Kampfsystem für das 3D-Spiel."""

from dataclasses import dataclass, field
from typing import Optional


@dataclass
class Monster:
    """Datenklasse für ein Monster."""
    name: str
    hp: int
    attack: int
    gold_drop: int = 0

    def __post_init__(self):
        if self.hp <= 0:
            raise ValueError("Monster HP muss positiv sein.")
        if self.attack < 0:
            raise ValueError("Monster Angriff darf nicht negativ sein.")
        if self.gold_drop < 0:
            raise ValueError("Gold-Drop darf nicht negativ sein.")


@dataclass
class Player:
    """Datenklasse für den Spieler."""
    name: str
    hp: int
    attack: int
    gold: int = 0

    def __post_init__(self):
        if self.hp <= 0:
            raise ValueError("Spieler HP muss positiv sein.")
        if self.attack < 0:
            raise ValueError("Spieler Angriff darf nicht negativ sein.")
        if self.gold < 0:
            raise ValueError("Spieler Gold darf nicht negativ sein.")


def resolve_combat_round(player: Player, monster: Monster) -> dict:
    """
    Löst eine Kampfrunde zwischen Spieler und Monster auf.

    Beide kämpfen gleichzeitig: Spieler greift an, Monster greift an.
    Wenn das Monster stirbt, erhält der Spieler den Gold-Drop.

    Args:
        player: Der Spieler.
        monster: Das Monster.

    Returns:
        Ein Dictionary mit den Ergebnissen der Runde:
        - 'player_damage': Schaden, den der Spieler dem Monster zugefügt hat.
        - 'monster_damage': Schaden, den das Monster dem Spieler zugefügt hat.
        - 'monster_alive': Ob das Monster noch lebt.
        - 'player_alive': Ob der Spieler noch lebt.
        - 'gold_gained': Gold, das der Spieler in dieser Runde erhalten hat.
    """
    # Spieler greift an
    player_damage = player.attack
    monster.hp -= player_damage

    # Monster greift an (nur wenn es noch lebt)
    monster_damage = 0
    if monster.hp > 0:
        monster_damage = monster.attack
        player.hp -= monster_damage

    # Gold-Drop, wenn Monster stirbt
    gold_gained = 0
    if monster.hp <= 0:
        gold_gained = monster.gold_drop
        player.gold += gold_gained

    return {
        'player_damage': player_damage,
        'monster_damage': monster_damage,
        'monster_alive': monster.hp > 0,
        'player_alive': player.hp > 0